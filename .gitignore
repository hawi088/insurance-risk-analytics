# Data files (tracked by DVC, not Git)
data/*.csv
data/*.txt
data/*.parquet

# But allow DVC metadata files (important!)
!data/*.dvc
!*.dvc

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# DVC internal
.dvc/
.dvcignore
dvc.lock
dvc.yaml

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
*.tmp
*.temp
*.bak

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb_checkpoints

# Environment variables
.env
.env.local